{
  "name": "codecli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeCLI: TypeScript + React Ink agent CLI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/main.tsx",
    "dev:deepseek": "tsx src/deepseek.tsx",
    "probe": "tsx src/probe.tsx",
    "test": "node --import tsx --test tests/run-tests.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^6.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
