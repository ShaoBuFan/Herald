# DeepSeek / OpenAI-compatible endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# bash 工具默认使用 bash.exe（Windows）或 $SHELL；需要时覆盖：
# CODECLI_BASH=/path/to/bash

# Alternative OpenAI env names are also supported by the adapter:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
