# 默认：仓库内统一存为 LF，检出到工作区也是 LF
* text=auto eol=lf

# 文本文件（显式声明，便于跨平台统计与 diff）
*.py     text
*.md     text
*.txt    text
*.json   text
*.jsonl  text
*.yml    text
*.yaml   text
*.toml   text
*.cfg    text
*.ini    text
*.csv    text

# 脚本：类 Unix 必须 LF，Windows 批处理/PowerShell 保持 CRLF
*.sh     text eol=lf
*.bash   text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制文件：不做换行符转换，不参与文本 diff
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.webp       binary
*.svg        text
*.pdf        binary
*.zip        binary
*.gz         binary
*.tar        binary
*.pt         binary
*.pth        binary
*.ckpt       binary
*.onnx       binary
*.safetensors binary
*.bin        binary
